ifneq ($(VBOX_GCC_VERSION_CC),)
 if $(VBOX_GCC_VERSION_CC) >= 40500
  VBOX_GCC_Wlogical-op                   ?= -Wlogical-op
  VBOX_GCC_Wno-logical-op                ?= $(subst -Wlogical-op,-Wno-logical-op,$(VBOX_GCC_Wlogical-op))
 endif
endif
