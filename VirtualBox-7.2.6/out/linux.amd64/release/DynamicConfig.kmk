# VBOX_GCC_TOOL=GXX3
VBOX_GCC_VERSION_CC                      ?= $(expr 10000 * 11 + 100 * $(firstword 4 0) + $(firstword 0 0))
VBOX_GCC_VERSION_CXX                     ?= $(expr 10000 * 11 + 100 * $(firstword 4 0) + $(firstword 0 0))
VBOX_GCC_PATH_CC                         ?= /usr/bin/gcc
VBOX_GCC_PATH_CXX                        ?= /usr/bin/g++
VBOX_GCC_LIBGCC                          ?= /usr/lib/gcc/x86_64-linux-gnu/11/libgcc.a
